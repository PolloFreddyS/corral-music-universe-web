---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { ui, locales, type Locale } from '~/i18n/ui';
import { verifiedPlatforms } from '~/lib/platforms';
import site from '~/data/site-config.json';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = ui[locale];
const email = site.contactEmail as string | null;
const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');
---

<BaseLayout locale={locale} title={t['links.title']} description={t['links.intro']} path="links/">
  <section class="section">
    <div class="wrap narrow">
      <p class="kicker">Corral Music Universe</p>
      <h1 class="title">{t['links.title']}</h1>
      <p class="intro">{t['links.intro']}</p>

      <ul class="list" role="list">
        {
          verifiedPlatforms.map((p, i) => (
            <li data-reveal data-ri={i}>
              <a href={p.url} target="_blank" rel="noopener noreferrer">
                <span class="name">{p.label}</span>
                <span class="host meta">{host(p.url)}</span>
                <span class="go" aria-hidden="true">
                  ↗
                </span>
                <span class="visually-hidden"> {t['links.newTab']}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <section class="contact" aria-labelledby="contact">
        <h2 id="contact" class="kicker">{t['links.contactHeading']}</h2>
        {email ? <a class="mail" href={`mailto:${email}`}>{email}</a> : <p class="muted">{t['links.contactPending']}</p>}
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 880px;
  }

  .title {
    font-size: var(--step-4);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .intro {
    margin: 1.5rem 0 3rem;
    color: var(--bone-dim);
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0 0 4rem;
    border-top: 1px solid var(--line);
  }

  .list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1.25rem;
    min-height: 88px;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-1) ease;
  }

  .go {
    font-size: var(--step-1);
    color: var(--bone-dim);
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-1) ease;
  }

  .list a:hover .name {
    transform: translateX(8px);
    color: #fff;
  }

  .list a:hover .go {
    transform: translate(3px, -3px);
    color: var(--oxblood-hover);
  }

  .muted {
    color: var(--bone-dim);
  }

  .mail {
    font-family: var(--font-display);
    font-size: var(--step-2);
  }

  @media (max-width: 520px) {
    .host {
      display: none;
    }

    .list a {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
