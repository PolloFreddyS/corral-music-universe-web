---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Artwork from '~/components/Artwork.astro';
import ListenLinks from '~/components/ListenLinks.astro';
import ReleaseCard from '~/components/ReleaseCard.astro';
import logo from '~/assets/brand/cmu-logo-official.png';
import { ui, locales, type Locale } from '~/i18n/ui';
import { getLatestRelease, getPublicReleases, verifiedLinks, formatDate } from '~/lib/releases';
import { pagePath, releasePath } from '~/lib/paths';
import { verifiedPlatforms } from '~/lib/platforms';
import brand from '~/data/brand.json';
import book from '~/data/book.json';
import { getBookCover } from '~/lib/book';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = ui[locale];
const latest = await getLatestRelease();
const all = await getPublicReleases();
const featured = all.filter((r) => r.id !== latest?.id).slice(0, 4);
const bookCover = await getBookCover();
const latestLinks = latest ? verifiedLinks(latest) : [];
const taglineLines = brand.tagline.es.split('. ').map((s, i, a) => (i < a.length - 1 ? `${s}.` : s));
---

<BaseLayout locale={locale} path="">
  {
    latest && (
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-bg" aria-hidden="true" />
        <div class="wrap hero-grid">
          <div class="hero-art" data-hero-art>
            <Artwork
              title={latest.data.title}
              id={latest.id}
              file={latest.data.artwork}
              locale={locale}
              sizes="(max-width: 860px) 88vw, 560px"
              widths={[360, 480, 640]}
              eager
            />
          </div>
          <div class="hero-copy">
            <p class="kicker hero-in" data-d="1">
              {t['home.latest']}
            </p>
            <p class="meta hero-in" data-d="2">
              {t[`type.${latest.data.type}`]} · {formatDate(latest.data.releaseDate, locale)}
            </p>
            <h1 id="hero-title" class="hero-title hero-in" data-d="3">
              {latest.data.title}
            </h1>
            {latest.data.description && (
              <p class="hero-desc hero-in" data-d="4">
                {latest.data.description[locale]}
              </p>
            )}
            <div class="hero-in" data-d="5">
              <ListenLinks links={latestLinks} locale={locale} />
            </div>
            <a class="text-link hero-in" data-d="6" href={releasePath(locale, latest.id)}>
              {t['home.details']} <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="manifesto section" aria-labelledby="manifesto-title">
    <div class="wrap manifesto-grid">
      <div class="manifesto-mark" data-reveal>
        <Image src={logo} alt="Corral Music Universe" width={420} height={420} widths={[280, 420, 640]} sizes="(max-width: 860px) 60vw, 420px" class="roundel" />
      </div>
      <div>
        <p class="kicker" data-reveal>{t['home.manifestoKicker']}</p>
        <h2 id="manifesto-title" class="tagline" lang="es">
          {
            taglineLines.map((line, i) => (
              <span class="line" data-reveal data-ri={i + 1}>
                {line}
              </span>
            ))
          }
        </h2>
        {locale === 'en' && <p class="translation" data-reveal data-ri="3">{brand.tagline.en}</p>}
        <div class="manifesto-body prose" data-reveal data-ri="3">
          <p>{t['home.manifesto1']}</p>
          <p>{t['home.manifesto2']}</p>
          <p>{t['home.manifesto3']}</p>
        </div>
        <a class="text-link" data-reveal data-ri="4" href={pagePath(locale, 'about')}>
          {t['home.manifestoLink']} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="featured section" aria-labelledby="featured-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="featured-title" class="section-title" data-reveal>
              {t['home.featured']}
            </h2>
            <a class="text-link" href={pagePath(locale, 'music')}>
              {t['home.allMusic']} <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="cards">
            {featured.map((r, i) => (
              <ReleaseCard release={r} locale={locale} index={i} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="book-teaser section" aria-labelledby="book-title">
    <div class="wrap book-grid">
      {
        bookCover ? (
          <div class="book-object has-cover" data-reveal>
            <div class="book-spine" aria-hidden="true" />
            <Image src={bookCover} alt={book.coverAlt[locale]} widths={[240, 360, 480]} sizes="(max-width: 860px) 220px, 300px" class="book-face book-img" />
          </div>
        ) : (
          <div class="book-object" aria-hidden="true" data-reveal>
            <div class="book-spine" />
            <div class="book-face">
              <span class="bf-title">La<br />Fórmula<br />del Verso</span>
              <span class="bf-author">{book.author}</span>
            </div>
          </div>
        )
      }
      <div>
        <p class="kicker" data-reveal>{t['home.bookKicker']}</p>
        <h2 id="book-title" class="section-title" data-reveal lang="es"><cite>{book.title}</cite></h2>
        <p class="lede" data-reveal data-ri="1">{t['home.bookBody']}</p>
        <a class="btn" data-reveal data-ri="2" href={pagePath(locale, 'book')}>
          {t['home.bookCta']} <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="follow section" aria-labelledby="follow-title">
    <div class="wrap">
      <h2 id="follow-title" class="kicker">{t['home.followKicker']}</h2>
      <ul class="platforms" role="list">
        {
          verifiedPlatforms.map((p, i) => (
            <li data-reveal data-ri={i}>
              <a href={p.url} target="_blank" rel="noopener noreferrer">
                <span class="p-name">{p.label}</span>
                <span class="p-arrow" aria-hidden="true">
                  ↗
                </span>
                <span class="visually-hidden"> {t['links.newTab']}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Hero ------------------------------------------------------------ */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 6.5rem) clamp(3.5rem, 7vw, 7.5rem);
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: -10% -10% 0;
    z-index: -1;
    background:
      radial-gradient(60% 55% at 22% 40%, rgb(179 38 30 / 0.16), transparent 70%),
      radial-gradient(40% 40% at 85% 10%, rgb(201 165 90 / 0.07), transparent 70%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5.5rem);
    align-items: center;
  }

  .hero-art {
    max-width: 600px;
    width: 100%;
  }

  .hero-title {
    font-size: var(--step-5);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 0.75rem 0 1.5rem;
    text-wrap: balance;
  }

  .hero-desc {
    font-size: var(--step-1);
    line-height: 1.45;
    color: color-mix(in srgb, var(--bone) 86%, var(--ink));
    max-width: 38ch;
    margin-bottom: 2rem;
  }

  .hero-copy .text-link {
    margin-top: 1.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-art {
      animation: art-reveal 1400ms var(--ease-out) both;
    }

    .hero-in {
      animation: rise 1000ms var(--ease-out) both;
      animation-delay: calc(250ms + var(--d, 0) * 90ms);
    }
  }

  @keyframes art-reveal {
    from {
      clip-path: inset(0 0 100% 0);
      transform: scale(1.04);
    }
    to {
      clip-path: inset(0 0 0 0);
      transform: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---- Manifesto --------------------------------------------------------- */
  .manifesto {
    border-top: 1px solid var(--line);
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: center;
  }

  .manifesto-mark :global(.roundel) {
    width: 100%;
    max-width: 420px;
    border-radius: 50%;
    margin-inline: auto;
    filter: saturate(0.92);
  }

  .tagline {
    font-size: var(--step-4);
    font-weight: 350;
    line-height: 1;
    letter-spacing: -0.025em;
    margin-bottom: 1rem;
  }

  .tagline .line {
    display: block;
  }

  .tagline .line:last-child {
    font-style: italic;
    color: var(--gold);
  }

  .translation {
    color: var(--bone-dim);
    font-style: italic;
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin-bottom: 2rem;
  }

  .manifesto-body {
    margin: 1.5rem 0 2rem;
  }

  /* ---- Featured ---------------------------------------------------------- */
  .featured {
    background: var(--ink-2);
    border-block: 1px solid var(--line);
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .section-title {
    font-size: var(--step-3);
    font-weight: 400;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }

  /* ---- Book teaser ------------------------------------------------------- */
  .book-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: center;
  }

  .book-teaser .lede {
    margin: 1.5rem 0 2.25rem;
    color: color-mix(in srgb, var(--bone) 90%, var(--ink));
  }

  cite {
    font-style: italic;
  }

  .book-object {
    position: relative;
    display: flex;
    max-width: 300px;
    aspect-ratio: 2 / 3;
    margin-inline: auto;
    width: 100%;
    perspective: 1200px;
  }

  .book-spine {
    width: 7%;
    background: linear-gradient(90deg, #0e1730, #1b2a52);
  }

  .book-face {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 14% 12%;
    background: linear-gradient(160deg, #1a2a55, #0d1631);
    color: #e0c48a;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.95);
    transform: rotateY(-8deg);
    transform-origin: left;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .book-object :global(.book-img) {
    padding: 0;
    width: 93%;
    height: 100%;
    object-fit: cover;
  }

  .book-object:hover .book-face {
    transform: rotateY(-2deg);
  }

  .bf-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    line-height: 1.05;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .bf-author {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
  }

  /* ---- Follow ------------------------------------------------------------ */
  .follow {
    border-top: 1px solid var(--line);
    padding-bottom: clamp(3rem, 5vw, 5rem);
  }

  .platforms {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .platforms a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.1rem, 2.5vw, 1.8rem) 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .p-name {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 350;
    letter-spacing: -0.02em;
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-1) ease;
  }

  .p-arrow {
    font-size: var(--step-2);
    color: var(--bone-dim);
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-1) ease;
  }

  .platforms a:hover .p-name {
    transform: translateX(10px);
    color: #fff;
  }

  .platforms a:hover .p-arrow {
    transform: translate(4px, -4px);
    color: var(--oxblood-hover);
  }

  /* ---- Responsive -------------------------------------------------------- */
  @media (max-width: 1100px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .hero-grid,
    .manifesto-grid,
    .book-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-art {
      max-width: 520px;
    }

    .manifesto-mark :global(.roundel) {
      max-width: 240px;
    }

    .book-object {
      max-width: 220px;
    }
  }

  @media (max-width: 520px) {
    .cards {
      gap: 1.25rem 1rem;
    }
  }
</style>
