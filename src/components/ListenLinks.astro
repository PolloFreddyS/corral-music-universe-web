---
import { ui, type Locale } from '~/i18n/ui';

interface Props {
  links: { id: string; label: string; url: string }[];
  locale: Locale;
  /** Make the first link the primary CTA. */
  primary?: boolean;
}
const { links, locale, primary = true } = Astro.props;
const t = ui[locale];
---

{
  links.length > 0 && (
    <ul class="listen" role="list">
      {links.map((l, i) => (
        <li>
          <a
            class:list={['btn', { 'btn--primary': primary && i === 0 }]}
            href={l.url}
            target="_blank"
            rel="noopener noreferrer"
            data-platform={l.id}
          >
            {primary && i === 0 ? `${t['home.listenOn']} ${l.label}` : l.label}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
            <span class="visually-hidden"> {t['links.newTab']}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .listen {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
