---
import Artwork from './Artwork.astro';
import { ui, type Locale } from '~/i18n/ui';
import { releasePath } from '~/lib/paths';
import type { Release } from '~/lib/releases';

interface Props {
  release: Release;
  locale: Locale;
  index?: number;
  headingLevel?: 'h2' | 'h3';
}
const { release, locale, index = 0, headingLevel = 'h3' } = Astro.props;
const t = ui[locale];
const d = release.data;
const H = headingLevel;
const year = d.releaseDate.slice(0, 4);
const count =
  d.tracklist.length === 1 ? t['music.trackCount1'] : t['music.tracksCount'].replace('{n}', String(d.tracklist.length));
---

<article class="card" data-reveal data-ri={index % 4} data-type={d.type}>
  <a href={releasePath(locale, release.id)} class="card-link">
    <div class="card-art">
      <Artwork
        title={d.title}
        id={release.id}
        file={d.artwork}
        locale={locale}
        sizes="(max-width: 600px) 92vw, (max-width: 1100px) 45vw, 300px"
        widths={[320, 480, 640]}
      />
    </div>
    <div class="card-body">
      <p class="meta">{t[`type.${d.type}`]} · {year}</p>
      <H class="card-title">{d.title}</H>
      <p class="meta count">{count}</p>
    </div>
  </a>
</article>

<style>
  .card-link {
    display: block;
    text-decoration: none;
  }

  .card-art {
    transition: transform var(--dur-3) var(--ease-out);
  }

  .card-art :global(.art) {
    transition:
      box-shadow var(--dur-3) var(--ease-out),
      filter var(--dur-3) var(--ease-out);
  }

  @media (hover: hover) {
    .card-link:hover .card-art {
      transform: translateY(-6px);
    }

    .card-link:hover .card-art :global(.art) {
      box-shadow: 0 40px 70px -30px rgb(0 0 0 / 0.95);
    }
  }

  .card-body {
    padding-top: 1.1rem;
  }

  .card-body .meta {
    margin: 0;
  }

  .card-title {
    font-size: var(--step-1);
    margin: 0.4rem 0 0.35rem;
    transition: color var(--dur-1) ease;
  }

  .card-link:hover .card-title {
    color: #fff;
  }

  .count {
    color: color-mix(in srgb, var(--bone-dim) 80%, var(--ink));
  }
</style>
