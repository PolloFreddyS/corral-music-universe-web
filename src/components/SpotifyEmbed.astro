---
/**
 * Privacy-first Spotify player: nothing is requested from Spotify until the
 * visitor presses the button. Without JavaScript the button is a plain link.
 */
import { ui, type Locale } from '~/i18n/ui';

interface Props {
  id: string;
  title: string;
  locale: Locale;
  height?: number;
}
const { id, title, locale, height = 352 } = Astro.props;
const t = ui[locale];
const src = `https://open.spotify.com/embed/album/${id}?utm_source=generator&theme=0`;
---

<div class="embed" data-spotify-embed data-src={src} data-title={`${t['release.playerTitle']} ${title}`} data-height={height}>
  <a class="btn" href={`https://open.spotify.com/album/${id}`} target="_blank" rel="noopener noreferrer" data-load>
    <span aria-hidden="true">▶</span>
    {t['release.playerLoad']}
  </a>
  <p class="note">{t['release.playerNote']}</p>
</div>

<script>
  function initEmbeds() {
    document.querySelectorAll<HTMLElement>('[data-spotify-embed]:not([data-bound])').forEach((box) => {
      box.dataset['bound'] = '1';
      const trigger = box.querySelector<HTMLAnchorElement>('[data-load]');
      trigger?.addEventListener('click', (e) => {
        e.preventDefault();
        const iframe = document.createElement('iframe');
        iframe.src = box.dataset['src'] ?? '';
        iframe.title = box.dataset['title'] ?? 'Spotify';
        iframe.width = '100%';
        iframe.height = box.dataset['height'] ?? '352';
        iframe.loading = 'lazy';
        iframe.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
        iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
        iframe.style.border = '0';
        iframe.style.borderRadius = '12px';
        box.replaceChildren(iframe);
        iframe.focus();
      });
    });
  }
  document.addEventListener('astro:page-load', initEmbeds);
</script>

<style>
  .embed {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 1.5rem;
    border: 1px solid var(--line);
    background: var(--ink-2);
    min-height: 120px;
  }

  .note {
    margin: 0;
    font-size: var(--step--1);
    color: var(--bone-dim);
    max-width: 52ch;
  }
</style>
