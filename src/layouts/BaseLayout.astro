---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/archivo/index.css';
import '~/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { ui, type Locale } from '~/i18n/ui';
import { withBase } from '~/lib/paths';
import site from '~/data/site-config.json';

interface Props {
  locale: Locale;
  /** Page title without the brand suffix. Omit for the home page. */
  title?: string;
  description?: string;
  /** Path after the locale segment, e.g. "music/" or "" for home. Used for canonical + hreflang. */
  path: string;
  /** Absolute or base-relative image for Open Graph. Defaults to the logo card. */
  ogImage?: string;
  ogType?: 'website' | 'music.album' | 'music.song' | 'book';
}

const { locale, title, description, path, ogImage, ogType = 'website' } = Astro.props;
const t = ui[locale];
const fullTitle = title ? `${title} — ${site.artistName}` : `${site.artistName} — ${t['home.title']}`;
const desc = description ?? t['meta.siteDescription'];
const siteUrl = Astro.site ?? new URL('https://example.invalid');
const abs = (p: string) => new URL(withBase(p), siteUrl).href;
const canonical = abs(`/${locale}/${path}`);
const alternates = {
  en: abs(`/en/${path}`),
  es: abs(`/es/${path}`),
  'x-default': abs('/'),
};
const og = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : new URL(ogImage, siteUrl).href
  : abs('/og-default.jpg');
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="es" href={alternates.es} />
    <link rel="alternate" hreflang="x-default" href={alternates['x-default']} />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />

    <meta property="og:site_name" content={site.artistName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={t['meta.ogLocale']} />
    <meta property="og:locale:alternate" content={ui[locale === 'en' ? 'es' : 'en']['meta.ogLocale']} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      import { STORAGE_KEY } from '~/lib/lang-storage';

      function initReveal() {
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in)');
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      }

      function initLangSwitch() {
        document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
          a.addEventListener('click', () => {
            try {
              localStorage.setItem(STORAGE_KEY, a.dataset['langSwitch'] ?? '');
            } catch {
              /* storage unavailable: the URL still carries the language */
            }
          });
        });
      }

      document.addEventListener('astro:page-load', () => {
        initReveal();
        initLangSwitch();
      });
    </script>
  </body>
</html>
