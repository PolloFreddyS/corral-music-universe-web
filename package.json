{
  "name": "corral-music-universe-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official static website for Corral Music Universe (Astro, GitHub Pages ready).",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "check:links": "node scripts/check-links.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "verify": "npm run lint && npm run check && npm run test && npm run build && npm run check:links",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "astro": "7.4.13",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.7",
    "astro-eslint-parser": "3.2.0",
    "axe-core": "4.14.1",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.14.0",
    "puppeteer-core": "25.19.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
